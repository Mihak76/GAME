  m_Script: {fileID: 11500000, guid: 2b29c8cd1f3f15840bf273e3a8034c7a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NotePickup
  noteText: "Audio Log \u2013 Unfinished\n\nI set up a recorder tonight to prove
    I wasn\u2019t imagining the sounds.\n\nAt 2:11 AM the device picked up movement
    outside the cabin.\nAt 2:14 AM the microphone registered whispering.\n\nI replayed
    the tape three times before I realized something was wrong.\n\nThe voice wasn\u2019t
    outside.\n\nIt was inside the cabin.\n\nBehind me.\n\nThe recording ends with
    the door opening.\n\nI don\u2019t remember opening the door."
