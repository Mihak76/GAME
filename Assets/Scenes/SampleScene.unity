MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 846609887}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 78fb7ea2f7ccd954a810ae2e8875dfb5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OutroController
  textComponent: {fileID: 505721628}
  skipTextUI: {fileID: 1023919168}
  outroPanel: {fileID: 846609887}
  fadeScreen: {fileID: 1875455828}
  fadeSpeed: 2
  outroParts:
  - 'The notes told the full story.


    Bill Denbrough and Cassidy Andrews were
    never truly missing.


    They had been here.


    They had found the same
    notes.


    They had followed the same trail.'
  - 'The disappearances weren''t random.


    This place draws people in.


    Investigators.
    Search parties. Curious souls.


    All looking for answers.


    All becoming
    part of the pattern.'
  - "I found the truth.\n\nBut the truth found me first.\n\nThe cycle continues.\n\nAnd
    somewhere out there\u2026\n\nThe next investigator is already on their way."
  - 'The truth is only beginning to surface.


    This is not the end.


    To
    be continued...'
  typingSpeed: 0.04
